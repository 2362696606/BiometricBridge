<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    x:Class="BiometricBridge.Views.DeviceListView"
    x:DataType="viewModels:DeviceListViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:BiometricBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDeviceItem}">
        <ListBox.Styles>
            <!--  提示挂在容器上：整行（含 ListBoxItem 的内边距）都能触发  -->
            <Style Selector="ListBoxItem">
                <Setter Property="ToolTip.Tip" Value="{Binding}" />
            </Style>
            <!--  ContentTemplate 是 ToolTip 控件自己的属性，只能这样指定，不能写成 ToolTip.ContentTemplate  -->
            <Style Selector="ToolTip">
                <Setter Property="ContentTemplate">
                    <!--  悬停时展示全部字段：ToolTip 的 Content 是 item 的 ViewModel，用这个模板渲染  -->
                    <DataTemplate DataType="viewModels:DeviceInfoItemViewModel">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DeviceId, StringFormat='DeviceId：{0}'}" />
                            <TextBlock Text="{Binding Status, StringFormat='状态：{0}'}" />
                            <TextBlock Text="{Binding Make, StringFormat='厂商：{0}'}" />
                            <TextBlock Text="{Binding Model, StringFormat='型号：{0}'}" />
                            <TextBlock Text="{Binding DeviceProvider, StringFormat='供应商：{0}'}" />
                            <TextBlock Text="{Binding DeviceProviderId, StringFormat='供应商标识：{0}'}" />
                            <TextBlock Text="{Binding DeviceSubIdsText, StringFormat='设备子 ID：{0}'}" />
                            <TextBlock Text="{Binding DeviceSubType, StringFormat='子类型：{0}'}" />
                            <TextBlock Text="{Binding Certification, StringFormat='认证等级：{0}'}" />
                            <TextBlock Text="{Binding Purpose, StringFormat='用途：{0}'}" />
                            <TextBlock Text="{Binding Modality, StringFormat='模态：{0}'}" />
                            <TextBlock Text="{Binding SerialNo, StringFormat='SN：{0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter>
            </Style>
            <!--
                列表项配色。颜色一律取自 Ursa 的 Semi 主题动态资源，随明/暗主题自动切换，不写死色值。
                分两组：默认一组是"未连接"的弱化配色，Grid.connected 一组（绑定自 IsConnected）在其上覆盖。
            -->
            <!--  未连接：徽标用中性填充 + 次级文字色，设备 ID 一并弱化  -->
            <Style Selector="Border.statusBadge">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            </Style>
            <Style Selector="Border.statusBadge TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            </Style>
            <Style Selector="TextBlock.deviceId">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            </Style>
            <!--  已连接：徽标改用主题强调色并反白文字，设备 ID 回到主文本色  -->
            <Style Selector="Grid.connected Border.statusBadge">
                <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
            </Style>
            <Style Selector="Grid.connected Border.statusBadge TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorWhite}" />
            </Style>
            <Style Selector="Grid.connected TextBlock.deviceId">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            </Style>
            <!--  标志性字段：次级文本色  -->
            <Style Selector="TextBlock.meta">
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
            <DataTemplate DataType="viewModels:DeviceInfoItemViewModel">
                <!--  Classes.connected 是下面所有配色的开关，样式见 ListBox.Styles  -->
                <Grid
                    Classes.connected="{Binding IsConnected}"
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto">
                    <!--  关键信息：DeviceId 与 Status 着重显示  -->
                    <TextBlock
                        Classes="deviceId"
                        FontFamily="Consolas"
                        FontSize="15"
                        FontWeight="Bold"
                        Grid.Column="0"
                        Grid.Row="0"
                        Text="{Binding DeviceId}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Classes="statusBadge"
                        CornerRadius="4"
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                    </Border>

                    <!--  标志性字段  -->
                    <StackPanel
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Classes="meta" Text="{Binding Make}" />
                        <TextBlock Classes="meta" Text="{Binding Model}" />
                        <TextBlock Classes="meta" Text="{Binding SerialNo}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
