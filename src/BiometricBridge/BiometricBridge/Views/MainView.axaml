<ContentPage
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    x:Class="BiometricBridge.Views.MainView"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:views="clr-namespace:BiometricBridge.Views"
    xmlns:vm="using:BiometricBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="7*,Auto,3*">
        <Grid ColumnDefinitions="2*,Auto,8*" Grid.Row="0">
            <views:DeviceListView Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="5" />
            <Grid Grid.Column="2" Grid.ColumnDefinitions="3*,Auto,7*">
                <views:DeviceControlView Grid.Column="0" />
                <GridSplitter Grid.Column="1" Width="5" />
                <ContentControl Grid.Column="2" />
            </Grid>
        </Grid>
        <GridSplitter Grid.Row="1" Height="5" />
        <views:LogView Grid.Row="2" />
    </Grid>
</ContentPage>