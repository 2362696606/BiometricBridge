<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!--  嵌入 GUI 进程的库，而非有发布约定的 web 应用，故不用 Microsoft.NET.Sdk.Web。
              代价：ASP.NET Core 框架引用会随项目引用传到消费方（Android/Browser 头因此无法构建）。  -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!--  Web 宿主跑在应用容器上，故这里认得 DryIoc。DryIoc.dll 随它传递进来。  -->
        <PackageReference Include="DryIoc.Microsoft.DependencyInjection" />
        <!--  宿主的 ILogger 要汇进应用那份 Serilog，故这里认得 Serilog。  -->
        <PackageReference Include="Serilog.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BiometricBridge.Core\BiometricBridge.Core.csproj" />
        <ProjectReference Include="..\BiometricBridge.Host\BiometricBridge.Host.csproj" />
    </ItemGroup>

</Project>
