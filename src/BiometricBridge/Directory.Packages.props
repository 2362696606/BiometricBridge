<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.3" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DryIoc 版本必须与 Prism.Container.DryIoc 带进来的 DryIoc.dll 一致：适配器是照这个容器写的，
         版本错开会变成运行期的事。 -->
    <PackageVersion Include="DryIoc.dll" Version="5.4.3" />
    <!-- 不用 8.0.0-preview：它要求 DryIoc.dll 6.x 预览版，会顶掉 Prism 脚下的 5.4.3。
         6.2.0 的下限是 DryIoc.dll >= 5.4.0，与上面那行相容。 -->
    <PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="6.2.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <!-- 虹膜 ISO 19794-6 记录里的图像数据必须是无损 JPEG2000。版本与参考实现 Com.ICT.SbiRegisterBridge
         一致：那边是用它过 CTK 的。随包分发 win/linux/osx 原生库，故只由 Host.Http 引用。 -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- SBI 的 JWS 签名（RS256 + x5c）。版本与参考实现 Com.ICT.SbiRegisterBridge 一致：那边是用它过 CTK 的。 -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageVersion Include="Prism.DryIoc.Avalonia" Version="9.0.537.11130" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <!-- 推流要编 JPEG（原始灰度 → M-JPEG）。版本与 Avalonia 12.1.3 带进来的一致，避免运行期出现两份 SkiaSharp。 -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <!-- 把宿主的 ILogger 汇进应用那份 Serilog。注意 Activity/span 是另一条管道，不由它管。 -->
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>